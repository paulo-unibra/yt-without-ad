{
  "expo": {
    "name": "YT-without-ad",
    "slug": "YT-without-ad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-yt.png",
    "scheme": "ytwithoutad",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F0F",
        "foregroundImage": "./assets/images/logo-yt.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-yt.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-yt.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0F0F0F",
          "dark": {
            "image": "./assets/images/logo-yt.png",
            "backgroundColor": "#0F0F0F"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
